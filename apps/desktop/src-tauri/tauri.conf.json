{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AA4C",
  "version": "0.7.0",
  "identifier": "com.aa4c.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AA连接",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/aria2c", "binaries/transmission-daemon", "binaries/llama-server"],
    "resources": {
      "binaries/transmission-daemon-*-libs/*": "transmission-libs/",
      "binaries/llama-server-*-libs/*": "llama-libs/"
    }
  }
}
